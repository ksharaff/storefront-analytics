# Secrets — never commit
.env

# Python
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local data / tooling
*.log
.vscode/
.idea/

# Production (deploy/): the server's .env is covered by ".env" above; the
# template is the one .env.example that IS committed. Backups hold customer
# data and never go into git.
!deploy/.env.example
deploy/backups/
