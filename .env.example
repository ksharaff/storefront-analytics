# Copy to .env. .env is gitignored — never commit real values.
# For the demo (scripts.seed_demo) the WooCommerce values can stay as they are:
# the dashboard only reads the local database.

# --- WooCommerce REST API (read-only key) ---
WC_BASE_URL=https://your-store.example.com
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Seconds before a request to a slow store gives up.
WC_TIMEOUT=60

# --- PostgreSQL (docker-compose.yml uses the same values) ---
POSTGRES_USER=storefront
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=storefront_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# --- Reporting ---
# Timestamps are stored in UTC and converted to this zone when grouping by day.
REPORT_TIMEZONE=Asia/Riyadh
# How far back data is imported (periods before this are flagged "incomplete").
HISTORY_START=2026-01-01

# --- OTO (tryoto.com) shipping platform, optional ---
# Without a token the storage app runs in test mode with made-up BOL numbers.
OTO_REFRESH_TOKEN=
