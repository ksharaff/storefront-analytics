# Production settings for deploy/docker-compose.yml.
# On the server:  cp .env.example .env && nano .env && chmod 600 .env
# .env is gitignored — real values never go into the repository.
# Keep comments on their own lines (not after a value).

# --- WooCommerce -----------------------------------------------------------
# The same read-only REST key the development machine uses.
WC_BASE_URL=https://example.com
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_TIMEOUT=60

# --- PostgreSQL ------------------------------------------------------------
# The database is only reachable inside Docker, but still use a strong
# password. Letters and digits only (it goes into a connection URL), e.g.:
#   openssl rand -hex 24
POSTGRES_USER=storefront
POSTGRES_PASSWORD=change-me
POSTGRES_DB=storefront_analytics

# --- Reporting -------------------------------------------------------------
REPORT_TIMEZONE=Asia/Riyadh

# --- Cloudflare Tunnel -----------------------------------------------------
# Zero Trust dashboard → Networks → Tunnels → your tunnel → the token shown in
# the "docker run" install command (the long string after --token).
TUNNEL_TOKEN=

# --- Schedules and ports (defaults are fine) -------------------------------
# Seconds between sync runs.
SYNC_EVERY=180
# Days of nightly backups to keep in deploy/backups/.
BACKUP_KEEP_DAYS=14
# Dashboard port on the server's loopback (127.0.0.1) only.
APP_PORT=8000

# OTO (tryoto.com): BOL numbers and box counts for the storage app. Secret.
OTO_REFRESH_TOKEN=
